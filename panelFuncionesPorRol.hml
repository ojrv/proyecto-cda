<section id="panelFuncionesPorRol">
  <h3>Funciones por rol</h3>
  <div class="bloque-rol" data-rol="admin">
    <h4>Admin</h4>
    <label><input type="checkbox" data-funcion="gestionar_usuarios"> Gestión de usuarios</label>
    <label><input type="checkbox" data-funcion="gestionar_reuniones"> Gestión de reuniones</label>
    <label><input type="checkbox" data-funcion="gestionar_canciones"> Gestión de canciones</label>
    <label><input type="checkbox" data-funcion="gestionar_tandas"> Gestión de tandas</label>
    <label><input type="checkbox" data-funcion="configuracion"> Configuración</label>
  </div>
  <!-- Repetir bloque para cada rol -->
</section>
